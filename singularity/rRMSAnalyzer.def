Bootstrap: docker
From: ghcr.io/lin-zhongbao/rrmsanalyzer:4.6.1-3.0.0

# Fallback definition file.
#
# The normal path is to let Singularity convert the published image itself:
#     singularity pull --arch amd64 rRMSAnalyzer.sif docker://ghcr.io/lin-zhongbao/rrmsanalyzer:4.6.1-3.0.0
#
# Building from this definition produces an equivalent image and is only useful
# when you want to rebuild locally (needs root or `singularity build --fakeroot`).

%labels
    org.opencontainers.image.source https://github.com/lin-zhongbao/rRMSAnalyzer
    org.opencontainers.image.version 3.0.0
    image.base rocker/r-ver:4.6.1
    cran.snapshot 2026-10-01
    bioconductor 3.23

%post
    echo "rRMSAnalyzer $(Rscript -e 'cat(as.character(packageVersion("rRMSAnalyzer")))') on $(R --version | head -n 1)"

%runscript
    exec Rscript "$@"

%help
    rRMSAnalyzer 3.0.0 runtime (R 4.6.1, Bioconductor 3.23, pandoc included)

    Examples:
      singularity exec rRMSAnalyzer.sif Rscript -e 'library(rRMSAnalyzer)'
      singularity run  rRMSAnalyzer.sif analysis.R
      singularity exec --bind "$PWD":/work --pwd /work rRMSAnalyzer.sif Rscript analysis.R
